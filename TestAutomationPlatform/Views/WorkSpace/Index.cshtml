@model List<TestAutomationPlatform.Models.Workspace>

@{
    ViewData["Title"] = "Workspaces";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2>Workspaces</h2>
            <p class="text-muted mb-0">
                Beheer de hoofdindeling van het TestAutomationPlatform. Workspaces worden gebruikt om scripts,
                categorieën en test-suites logisch te groeperen.
            </p>
        </div>

        <span class="badge bg-secondary mt-2">
            Admin beheer
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Nieuwe workspace</h5>
                    <p class="text-muted">
                        Maak een workspace aan om scripts, categorieën en test-suites onder te verdelen.
                    </p>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">Workspacenaam</label>
                            <input name="name" class="form-control" placeholder="Bijv. Kreuze Website" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Workspace opslaan
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Bestaande workspaces</h5>

                    @if (!Model.Any())
                    {
                        <div class="alert alert-info mb-0">
                            Er zijn nog geen workspaces aangemaakt.
                        </div>
                    }
                    else
                    {
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Naam</th>
                                    <th>Actie</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var workspace in Model)
                                {
                                    <tr>
                                        <td>@workspace.Id</td>
                                        <td class="fw-semibold">@workspace.Name</td>
                                        <td>
                                            <form asp-action="Delete" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@workspace.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('Weet je zeker dat je deze workspace wilt verwijderen?');">
                                                    Verwijderen
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>