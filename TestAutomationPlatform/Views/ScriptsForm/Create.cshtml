@model TestAutomationPlatform.Models.ScriptFormViewModel

@{
    ViewData["Title"] = "Nieuw Script";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="mb-1">Nieuw Script</h2>

        <p class="text-muted mb-0">
            @ViewBag.WorkspaceName /
            @ViewBag.CategoryName /
            @ViewBag.TestSuiteName
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-controller="ScriptsForm"
                  asp-action="Create"
                  method="post">
                @Html.AntiForgeryToken()

                @* Tijdelijk nodig totdat de oude databasevelden verwijderd zijn. *@
                <input asp-for="WorkspaceId" type="hidden" />
                <input asp-for="CategoryId" type="hidden" />
                <input asp-for="TestSuiteId" type="hidden" />

                <div class="mb-4">
                    <label class="form-label">Locatie</label>

                    <input type="text"
                           class="form-control"
                           value="@ViewBag.WorkspaceName / @ViewBag.CategoryName / @ViewBag.TestSuiteName"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Scriptnaam
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Voer een scriptnaam in" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>
                </div>

                <partial name="_StepBuilder" model="Model" />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit"
                            class="btn btn-success">
                        Opslaan
                    </button>

                    <a asp-controller="ScriptsForm"
                       asp-action="Index"
                       asp-route-testSuiteId="@Model.TestSuiteId"
                       class="btn btn-secondary">
                        Terug
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}