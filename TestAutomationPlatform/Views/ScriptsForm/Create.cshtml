@model TestAutomationPlatform.Models.ScriptFormViewModel

@{
    ViewData["Title"] = "Nieuw Script";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="mb-1">Nieuw Script</h2>
        <p class="text-muted mb-0">Voeg een nieuw testscript toe aan het platform</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-controller="ScriptsForm" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Script naam</label>
                    <input asp-for="Name" class="form-control" placeholder="Voer een scriptnaam in" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="WorkspaceId" class="form-label">Workspace</label>
                    <select asp-for="WorkspaceId" asp-items="Model.Workspaces" class="form-select">
                        <option value="">-- Kies een workspace --</option>
                    </select>
                    <span asp-validation-for="WorkspaceId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TestSuiteId" class="form-label">TestSuite</label>
                    <select asp-for="TestSuiteId" asp-items="Model.TestSuites" class="form-select">
                        <option value="">-- Kies een testsuite --</option>
                    </select>
                    <span asp-validation-for="TestSuiteId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Categorie</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">-- Kies een categorie --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label">Script JSON</label>
                    <textarea asp-for="Code"
                              class="form-control"
                              rows="12"
                              placeholder="Voer hier de JSON-stappen van het script in"></textarea>
                    <span asp-validation-for="Code" class="text-danger"></span>
                    <small class="text-muted">
                        Gebruik geldige JSON-stappen zoals goto, click, fill, wait, asserttitle en assertelement.
                    </small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Opslaan
                    </button>
                    <a asp-controller="ScriptsForm" asp-action="Index" class="btn btn-secondary">
                        Terug
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}