@model TestAutomationPlatform.Models.ScriptFormViewModel

@{
    ViewData["Title"] = "Script Bewerken";
}

<section class="page-header">
    <div>
        <p class="text-muted mb-1">Script library</p>
        <h1 class="h3 mb-0">Script bewerken</h1>
    </div>
</section>

<section class="panel">
    <form asp-controller="ScriptsForm" asp-action="Edit" method="post" class="script-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-lg-6">
                <label asp-for="Name" class="form-label">Script naam</label>
                <input asp-for="Name" class="form-control" placeholder="Bijv. Login smoke test" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-lg-2">
                <label asp-for="WorkspaceId" class="form-label">Workspace</label>
                <select asp-for="WorkspaceId" asp-items="Model.Workspaces" class="form-select">
                    <option value="0">Kies</option>
                </select>
                <span asp-validation-for="WorkspaceId" class="text-danger"></span>
            </div>

            <div class="col-lg-2">
                <label asp-for="TestSuiteId" class="form-label">TestSuite</label>
                <select asp-for="TestSuiteId" asp-items="Model.TestSuites" class="form-select">
                    <option value="0">Kies</option>
                </select>
                <span asp-validation-for="TestSuiteId" class="text-danger"></span>
            </div>

            <div class="col-lg-2">
                <label asp-for="CategoryId" class="form-label">Categorie</label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="0">Kies</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
        </div>

        @await Html.PartialAsync("_StepBuilder", Model)

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-warning">
                <i class="bi bi-save me-1"></i>Opslaan
            </button>
            <a asp-controller="ScriptsForm" asp-action="Index" class="btn btn-outline-secondary">Terug</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}