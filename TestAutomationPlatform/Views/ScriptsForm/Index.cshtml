@model List<TestAutomationPlatform.Models.Script>

@{
    ViewData["Title"] = "Scripts";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Script Management</h2>
            <p class="text-muted mb-0">Beheer en bekijk alle testscripts</p>
        </div>

        <a asp-controller="Scripts" asp-action="Create" class="btn btn-primary">
            Nieuw Script
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    Er zijn nog geen scripts beschikbaar.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Naam</th>
                                <th>Workspace</th>
                                <th>Suite</th>
                                <th>Categorie</th>
                                <th>Aangemaakt op</th>
                                <th>Code Preview</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var script in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@script.Name</td>
                                    <td>@script.Workspace?.Name</td>
                                    <td>@script.TestSuite?.Name</td>
                                    <td>@script.Category?.Name</td>
                                    <td>@script.CreatedAt.ToString("dd-MM-yyyy HH:mm:ss")</td>
                                    <td style="max-width: 300px;">
                                        <pre class="bg-light p-2 rounded border mb-0" style="white-space: pre-wrap; font-size: 12px; max-height: 120px; overflow-y: auto;">@script.Code</pre>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>