@model List<TestAutomationPlatform.Models.Script>

@{
    ViewData["Title"] = "Scripts";

    bool isSuiteView = ViewBag.IsSuiteView == true;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                @if (isSuiteView)
                {
                    <span>Scripts</span>
                }
                else
                {
                    <span>Alle scripts</span>
                }
            </h2>

            @if (isSuiteView)
            {
                <p class="text-muted mb-0">
                    @ViewBag.WorkspaceName /
                    @ViewBag.CategoryName /
                    @ViewBag.TestSuiteName
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    Overzicht van alle scripts binnen alle workspaces, categorieën en test-suites.
                </p>
            }
        </div>

        @if (isSuiteView)
        {
            <a asp-controller="ScriptsForm"
                   asp-action="Create"
                   asp-route-testSuiteId="@ViewBag.TestSuiteId"
                   class="btn btn-primary">
                <i class="bi bi-plus-lg"></i>
                Nieuw Script
            </a>
        }
        else
        {
            <a asp-controller="TestStructure"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                Nieuw script via teststructuur
            </a>
        }
    </div>

    <div id="signalRUpdateMessage"
         class="alert alert-info alert-dismissible fade show"
         style="display:none;"
         role="alert">
        Er is een nieuw testresultaat ontvangen. De pagina wordt bijgewerkt.

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Sluiten">
        </button>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Message"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (!Model.Any())
            {
                @if (isSuiteView)
                {
                    <div class="alert alert-info mb-0">
                        Deze test-suite bevat nog geen scripts.
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        Er zijn nog geen scripts aangemaakt.
                        Maak eerst een script aan via Teststructuur.
                    </div>
                }
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Naam</th>
                                <th>Workspace</th>
                                <th>Categorie</th>
                                <th>Test-suite</th>
                                <th>Aangemaakt</th>
                                <th>Code</th>
                                <th>Acties</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var script in Model)
                            {
                                var workspaceName =
                                    script.TestSuite?.Category?.Workspace?.Name
                                    ?? script.Category?.Workspace?.Name
                                    ?? script.Workspace?.Name
                                    ?? "Onbekend";

                                var categoryName =
                                    script.TestSuite?.Category?.Name
                                    ?? script.Category?.Name
                                    ?? "Onbekend";

                                var testSuiteName =
                                    script.TestSuite?.Name
                                    ?? "Onbekend";

                                <tr>
                                    <td class="fw-semibold">
                                        @script.Name
                                    </td>

                                    <td>@workspaceName</td>

                                    <td>@categoryName</td>

                                    <td>@testSuiteName</td>

                                    <td>
                                        @script.CreatedAt.ToString("dd-MM-yyyy HH:mm:ss")
                                    </td>

                                    <td style="max-width:300px;">
                                        <pre class="bg-light p-2 rounded border mb-0"
                                             style="white-space:pre-wrap; font-size:12px; max-height:120px; overflow-y:auto;">@script.Code</pre>
                                    </td>

                                    <td>
                                        <div class="d-flex gap-2">
                                            <form asp-action="Run"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@script.Id" />

                                                @if (isSuiteView)
                                                {
                                                    <input type="hidden"
                                                           name="testSuiteId"
                                                           value="@ViewBag.TestSuiteId" />
                                                }

                                                <button type="submit"
                                                        class="btn btn-success btn-sm"
                                                        title="Uitvoeren">
                                                    <i class="bi bi-play-fill"></i>
                                                </button>
                                            </form>

                                            <a asp-action="Edit"
                                                   asp-route-id="@script.Id"
                                                   class="btn btn-warning btn-sm"
                                                   title="Bewerken">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>

                                            <form asp-action="Delete"
                                                  method="post"
                                                  onsubmit="return confirm('Weet je zeker dat je dit script wilt verwijderen?');">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@script.Id" />

                                                @if (isSuiteView)
                                                {
                                                    <input type="hidden"
                                                           name="testSuiteId"
                                                           value="@ViewBag.TestSuiteId" />
                                                }

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm"
                                                        title="Verwijderen">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
        .withUrl("/testResultHub")
        .withAutomaticReconnect()
        .build();

        connection.on("TestResultUpdated", function () {
        console.log("SignalR: testresultaat ontvangen.");

        const message = document.getElementById("signalRUpdateMessage");

        if (message) {
        message.style.display = "block";
        }

        setTimeout(function () {
        location.reload();
        }, 1000);
        });

        connection.start()
        .then(function () {
        console.log("SignalR verbonden met testResultHub.");
        })
        .catch(function (err) {
        console.error("SignalR fout:", err.toString());
        });
    </script>
}