@model List<TestAutomationPlatform.Models.Script>

@{
    ViewData["Title"] = "Scripts";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Script Management</h2>
            <p class="text-muted mb-0">Beheer en run je testscripts</p>
        </div>

        <a asp-controller="ScriptsForm" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Nieuw Script
        </a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">
                    Er zijn nog geen scripts beschikbaar.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Naam</th>
                                <th>Workspace</th>
                                <th>Suite</th>
                                <th>Categorie</th>
                                <th>Aangemaakt op</th>
                                <th>Code</th>
                                <th>Acties</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var script in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@script.Name</td>

                                    <td>@script.Workspace?.Name</td>
                                    <td>@script.TestSuite?.Name</td>
                                    <td>@script.Category?.Name</td>

                                    <td>
                                        @script.CreatedAt.ToString("dd-MM-yyyy HH:mm:ss")
                                    </td>

                                    <td style="max-width:300px;">
                                        <pre class="bg-light p-2 rounded border mb-0"
                                             style="white-space: pre-wrap; font-size: 12px; max-height:120px; overflow-y:auto;">
                                            @script.Code
                                        </pre>
                                    </td>

                                    <td class="d-flex gap-2">

                                        <!-- RUN -->
                                        <form asp-action="Run" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@script.Id" />

                                            <button class="btn btn-success btn-sm">
                                                <i class="bi bi-play-fill"></i>
                                            </button>
                                        </form>

                                        <!-- EDIT -->
                                        <a asp-action="Edit"
                                               asp-route-id="@script.Id"
                                               class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        <!-- DELETE -->
                                        <form asp-action="Delete"
                                              method="post"
                                              onsubmit="return confirm('Weet je zeker dat je dit script wilt verwijderen?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@script.Id" />

                                            <button class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>