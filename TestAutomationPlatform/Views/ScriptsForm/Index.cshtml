@model List<TestAutomationPlatform.Models.Script>

@{
    ViewData["Title"] = "Scripts";
}

<section class="page-header">
    <div>
        <p class="text-muted mb-1">Script library</p>
        <h1 class="h3 mb-0">Scripts</h1>
    </div>

    <a asp-controller="ScriptsForm" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Nieuw script
    </a>
</section>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="panel">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-code-square"></i>
            <strong>Geen scripts beschikbaar</strong>
            <span>Maak je eerste script aan om test runs te starten.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle result-table mb-0">
                <thead>
                    <tr>
                        <th>Naam</th>
                        <th>Groepering</th>
                        <th>Aangemaakt</th>
                        <th>Code</th>
                        <th class="text-end">Acties</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var script in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@script.Name</td>
                            <td>
                                <div>@script.Workspace?.Name</div>
                                <div class="small text-muted">@script.TestSuite?.Name / @script.Category?.Name</div>
                            </td>
                            <td>@script.CreatedAt.ToString("dd-MM-yyyy HH:mm:ss")</td>
                            <td style="max-width:360px;">
                                <pre class="script-preview mb-0">@script.Code</pre>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group" aria-label="Script actions">
                                    <form asp-action="Run" method="post" class="d-inline-flex">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@script.Id" />
                                        <input type="hidden" name="environment" value="Dev" />
                                        <button class="btn btn-outline-success" title="Run in Dev">
                                            <i class="bi bi-play-fill"></i>
                                        </button>
                                    </form>

                                    <a asp-action="Edit" asp-route-id="@script.Id" class="btn btn-outline-secondary" title="Bewerken">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <form asp-action="Delete" method="post" class="d-inline-flex" onsubmit="return confirm('Weet je zeker dat je dit script wilt verwijderen?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@script.Id" />
                                        <button class="btn btn-outline-danger" title="Verwijderen">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
