@model List<string>

@{
    var path = ViewBag.Path as string;
}

@if (Model == null || !Model.Any())
{
    <div class="empty-state compact">
        <i class="bi bi-image"></i>
        <strong>Geen screenshots gevonden</strong>
        <span>Voor deze run zijn geen beelden beschikbaar.</span>
    </div>
}
else
{
    <div class="screenshot-grid">
        @foreach (var file in Model)
        {
            var imagePath = $"/screenshots/{path}/{file}";

            <button type="button" class="screenshot-tile" data-fullscreen-image="@imagePath">
                <img src="@imagePath" alt="Screenshot @file" />
                <span>@file</span>
            </button>
        }
    </div>
}
