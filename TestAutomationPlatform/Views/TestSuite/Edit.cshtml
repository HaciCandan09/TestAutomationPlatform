@model TestSuite

@{
    ViewData["Title"] = "TestSuite Bewerken";
}

<section class="page-header"><div><p class="text-muted mb-1">TestSuites</p><h1 class="h3 mb-0">TestSuite bewerken</h1></div></section>

<section class="panel">
    <form asp-action="Edit" method="post" class="entity-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Naam</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="WorkspaceId" class="form-label">Workspace</label>
            <select asp-for="WorkspaceId" asp-items="ViewBag.Workspaces" class="form-select">
                <option value="0">Kies een workspace</option>
            </select>
            <span asp-validation-for="WorkspaceId" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning"><i class="bi bi-save me-1"></i>Opslaan</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Terug</a>
        </div>
    </form>
</section>