@model List<TestAutomationPlatform.Models.DashboardViewModel>

@{
    ViewData["Title"] = "Dashboard";

    var totalRuns = (int)ViewBag.TotalRuns;
    var passedRuns = (int)ViewBag.PassedRuns;
    var failedRuns = (int)ViewBag.FailedRuns;
    var avgExecutionTime = (double)ViewBag.AverageExecutionTime;
    var lastRunAt = ViewBag.LastRunAt is DateTime value ? value : (DateTime?)null;
    var selectedEnvironment = (string)ViewBag.Environment;
    var selectedStatus = (string)ViewBag.Status;
    var search = (string)ViewBag.Search;
    var resultLimit = (int)ViewBag.ResultLimit;

    var devSelected = selectedEnvironment == "Dev" ? "selected" : null;
    var preprodSelected = selectedEnvironment == "Preprod" ? "selected" : null;
    var prodSelected = selectedEnvironment == "Prod" ? "selected" : null;
    var passSelected = selectedStatus == "Pass" ? "selected" : null;
    var failSelected = selectedStatus == "Fail" ? "selected" : null;

    var passRate = totalRuns == 0 ? 0 : Math.Round((double)passedRuns / totalRuns * 100, 1);

    var runsPerScript = Model
        .GroupBy(x => x.ScriptName)
        .Select(g => new { ScriptName = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .Take(8)
        .ToList();

    var statusLabels = new[] { "Pass", "Fail" };
    var statusData = new[] { passedRuns, failedRuns };
    var scriptLabels = runsPerScript.Select(x => x.ScriptName).ToList();
    var scriptData = runsPerScript.Select(x => x.Count).ToList();
}

<section class="page-header">
    <div>
        <p class="text-muted mb-1">Test operations</p>
        <h1 class="h3 mb-0">Dashboard</h1>
    </div>

    <form method="post" asp-controller="Run" asp-action="StartRun" class="run-now-panel">
        <select name="environment" class="form-select" aria-label="Environment">
            <option value="Dev" selected="@devSelected">Development</option>
            <option value="Preprod" selected="@preprodSelected">Pre-production</option>
            <option value="Prod" selected="@prodSelected">Production</option>
        </select>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-play-fill me-1"></i>Run tests
        </button>
    </form>
</section>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="metric-grid">
    <div class="metric-card">
        <span class="metric-label">Runs</span>
        <strong>@totalRuns</strong>
        <span class="metric-note">Laatste @resultLimit resultaten</span>
    </div>
    <div class="metric-card">
        <span class="metric-label">Pass rate</span>
        <strong class="text-success">@passRate%</strong>
        <span class="metric-note">@passedRuns geslaagd</span>
    </div>
    <div class="metric-card">
        <span class="metric-label">Failures</span>
        <strong class="text-danger">@failedRuns</strong>
        <span class="metric-note">Onderzoek nodig</span>
    </div>
    <div class="metric-card">
        <span class="metric-label">Gem. uitvoertijd</span>
        <strong>@Math.Round(avgExecutionTime, 2) s</strong>
        <span class="metric-note">@(lastRunAt.HasValue ? $"Laatste run {lastRunAt.Value:dd-MM HH:mm}" : "Nog geen runs")</span>
    </div>
</section>

<section class="dashboard-grid">
    <div class="panel">
        <div class="panel-header">
            <h2 class="h6 mb-0">Statusverdeling</h2>
        </div>
        <canvas id="statusChart" height="180"></canvas>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h2 class="h6 mb-0">Meest uitgevoerde scripts</h2>
        </div>
        <canvas id="scriptChart" height="180"></canvas>
    </div>
</section>

<section class="panel">
    <form method="get" asp-controller="Dashboard" asp-action="Index" class="filter-bar">
        <div>
            <label for="search" class="form-label">Script</label>
            <input type="search" id="search" name="search" value="@search" class="form-control" placeholder="Zoek script" />
        </div>

        <div>
            <label for="environment" class="form-label">Environment</label>
            <select id="environment" name="environment" class="form-select">
                <option value="">Alle</option>
                <option value="Dev" selected="@devSelected">Development</option>
                <option value="Preprod" selected="@preprodSelected">Pre-production</option>
                <option value="Prod" selected="@prodSelected">Production</option>
            </select>
        </div>

        <div>
            <label for="status" class="form-label">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="">Alle</option>
                <option value="Pass" selected="@passSelected">Pass</option>
                <option value="Fail" selected="@failSelected">Fail</option>
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-funnel me-1"></i>Filter
            </button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary" title="Reset filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h2 class="h6 mb-0">Resultaten</h2>
            <p class="text-muted mb-0 small">Automatisch vernieuwd zonder de pagina te herladen.</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-clipboard-data"></i>
            <strong>Geen resultaten gevonden</strong>
            <span>Pas je filters aan of start een nieuwe test run.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle result-table mb-0">
                <thead>
                    <tr>
                        <th>Script</th>
                        <th>Environment</th>
                        <th>Status</th>
                        <th>Uitvoertijd</th>
                        <th>Uitgevoerd</th>
                        <th class="text-end">Acties</th>
                    </tr>
                </thead>
                <tbody id="resultsBody">
                    @await Html.PartialAsync("PartialDataRefresh", Model)
                </tbody>
            </table>
        </div>
    }
</section>

<div class="modal fade" id="screenshotModal" tabindex="-1" aria-labelledby="screenshotModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="screenshotModalLabel">Screenshots</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="screenshotModalBody">
                <div class="text-muted">Laden...</div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusLabels));
    const statusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(statusData));
    const scriptLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(scriptLabels));
    const scriptData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(scriptData));

    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: statusLabels,
            datasets: [{
                data: statusData,
                backgroundColor: ['#198754', '#dc3545'],
                borderWidth: 0
            }]
        },
        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }
    });

    new Chart(document.getElementById('scriptChart'), {
        type: 'bar',
        data: {
            labels: scriptLabels,
            datasets: [{ data: scriptData, backgroundColor: '#0d6efd', borderRadius: 4 }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });

    document.addEventListener('click', async (event) => {
        const logButton = event.target.closest('[data-log-toggle]');
        if (logButton) {
            const logRow = document.getElementById(logButton.dataset.logToggle);
            if (logRow) {
                logRow.style.display = logRow.style.display === 'none' || logRow.style.display === '' ? 'table-row' : 'none';
            }
        }

        const screenshotButton = event.target.closest('[data-screenshot-path]');
        if (screenshotButton) {
            await openScreenshotModal(screenshotButton.dataset.screenshotPath);
        }

        const fullScreenImage = event.target.closest('[data-fullscreen-image]');
        if (fullScreenImage) {
            window.open(fullScreenImage.dataset.fullscreenImage, '_blank', 'noopener');
        }
    });

    async function openScreenshotModal(path) {
        const modalBody = document.getElementById('screenshotModalBody');
        modalBody.innerHTML = '<div class="text-muted">Laden...</div>';

        try {
            const response = await fetch(`/Screenshots/RunImages?path=${encodeURIComponent(path)}`);
            modalBody.innerHTML = await response.text();
            new bootstrap.Modal(document.getElementById('screenshotModal')).show();
        } catch {
            modalBody.innerHTML = '<div class="alert alert-danger mb-0">Kon screenshots niet laden.</div>';
        }
    }

    setInterval(async () => {
        const query = new URLSearchParams(window.location.search);
        const response = await fetch(`/Dashboard/GetResultsPartial?${query.toString()}`);
        if (response.ok) {
            document.getElementById('resultsBody').innerHTML = await response.text();
        }
    }, 15000);
</script>
