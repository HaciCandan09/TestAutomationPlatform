@model List<TestAutomationPlatform.Models.DashboardViewModel>

@foreach (var item in Model)
{
    var statusClass = item.Passed ? "success" : "danger";
    var statusIcon = item.Passed ? "bi-check-circle" : "bi-x-circle";

    <tr class="result-row"
        data-status="@item.Status"
        data-script="@item.ScriptName.ToLowerInvariant()"
        data-environment="@item.Environment"
        data-date="@item.ExecutedAt.Ticks">

        <td>
            <div class="fw-semibold">@item.ScriptName</div>
            <div class="small text-muted">
                @item.WorkspaceName / @item.TestSuiteName / @item.CategoryName
            </div>
        </td>

        <td>
            <span class="badge rounded-pill text-bg-secondary">@item.Environment</span>
        </td>

        <td>
            <span class="badge rounded-pill text-bg-@statusClass">
                <i class="bi @statusIcon me-1"></i>@item.Status
            </span>
        </td>

        <td>@Math.Round(item.ExecutionTime, 2) s</td>
        <td>@item.ExecutedAt.ToString("dd-MM-yyyy HH:mm:ss")</td>

        <td class="text-end">
            <div class="btn-group btn-group-sm" role="group" aria-label="Result actions">
                <button class="btn btn-outline-secondary" type="button" data-log-toggle="log-@item.Id" title="Toon log">
                    <i class="bi bi-card-text"></i>
                </button>

                @if (!string.IsNullOrEmpty(item.ScreenshotPath))
                {
                    <button type="button"
                            class="btn btn-outline-primary"
                            data-screenshot-path="@item.ScreenshotPath"
                            title="Bekijk screenshots">
                        <i class="bi bi-images"></i>
                    </button>
                }
            </div>
        </td>
    </tr>

    <tr class="log-row" id="log-@item.Id" style="display:none;">
        <td colspan="6">
            <pre class="result-log mb-0">@item.Log</pre>
        </td>
    </tr>
}
