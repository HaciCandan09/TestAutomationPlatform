@model TestAutomationPlatform.Models.ScheduledRunViewModel

@{
    ViewData["Title"] = "Geplande runs";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="mb-1">Geplande runs</h2>
        <p class="text-muted mb-0">
            Koppel scripts aan Hangfire zodat ze automatisch volgens een planning worden uitgevoerd.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Nieuwe geplande run</h5>

            @if (!Model.Scripts.Any())
            {
                <div class="alert alert-warning mb-0">
                    Er zijn nog geen scripts beschikbaar. Maak eerst een script aan voordat je een planning toevoegt.
                </div>
            }
            else
            {
                <form asp-controller="ScheduledRun" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label asp-for="ScriptId" class="form-label">Script</label>
                            <select asp-for="ScriptId" asp-items="Model.Scripts" class="form-select">
                                <option value="">-- Kies een script --</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Environment" class="form-label">Environment</label>
                            <select asp-for="Environment" class="form-select">
                                <option value="Dev">Development</option>
                                <option value="Preprod">Pre-Production</option>
                                <option value="Prod">Production</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Interval" class="form-label">Interval</label>
                            <select asp-for="Interval" class="form-select">
                                <option value="Every5Minutes">Elke 5 minuten</option>
                                <option value="Every15Minutes">Elke 15 minuten</option>
                                <option value="Every30Minutes">Elke 30 minuten</option>
                                <option value="Hourly">Elk uur</option>
                                <option value="Daily">Dagelijks om 08:00</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                Opslaan
                            </button>
                        </div>
                    </div>
                </form>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title mb-3">Bestaande geplande runs</h5>

            @if (!Model.ScheduledRuns.Any())
            {
                <div class="alert alert-info mb-0">
                    Er zijn nog geen geplande runs aangemaakt.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Script</th>
                                <th>Environment</th>
                                <th>Planning</th>
                                <th>Status</th>
                                <th>Aangemaakt op</th>
                                <th>Actie</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var scheduledRun in Model.ScheduledRuns)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @scheduledRun.Script.Name
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @scheduledRun.Environment
                                        </span>
                                    </td>

                                    <td>
                                        @scheduledRun.Description
                                    </td>

                                    <td>
                                        @if (scheduledRun.IsActive)
                                        {
                                            <span class="badge bg-success">Actief</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactief</span>
                                        }
                                    </td>

                                    <td>
                                        @scheduledRun.CreatedAt.ToString("dd-MM-yyyy HH:mm")
                                    </td>

                                    <td>
                                        <form asp-controller="ScheduledRun"
                                              asp-action="Delete"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@scheduledRun.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Weet je zeker dat je deze geplande run wilt verwijderen?');">
                                                Verwijderen
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>