@{
    ViewData["Title"] = "Home";
}

<section class="tap-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="tap-label">TestAutomationPlatform</div>

                <h1 class="tap-title">
                    Beheer, voer uit en analyseer geautomatiseerde tests.
                </h1>

                <p class="tap-subtitle">
                    Een centrale beheeromgeving voor testscripts, testruns, rapportages,
                    screenshots, logs en lichte defectopvolging.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="tap-image-card">
                    <img src="~/images/Kreuzelogo.png"
                         asp-append-version="true"
                         alt="TestAutomationPlatform overzicht"
                         class="tap-hero-image" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container mt-5 mb-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="tap-card">
                <h5>Tests beheren</h5>
                <p>
                    Maak scripts aan, koppel ze aan workspaces, categorieën en test-suites
                    en beheer teststructuren centraal.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="tap-card">
                <h5>Resultaten analyseren</h5>
                <p>
                    Bekijk pass/fail-statussen, uitvoeringstijden, logs en screenshots
                    vanuit één overzichtelijk dashboard.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="tap-card">
                <h5>Defecten opvolgen</h5>
                <p>
                    Maak vanuit gefaalde testresultaten defecten aan en koppel deze aan
                    foutinformatie en bewijslast.
                </p>
            </div>
        </div>
    </div>
</section>