@model TestAutomationPlatform.Models.TestStructureViewModel

@{
    ViewData["Title"] = "Teststructuur";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                Workspace(s)
                @if (Model.SelectedWorkspaceName != null)
                {
                    <span>: @Model.SelectedWorkspaceName</span>
                }
            </h2>
            <p class="text-muted mb-0">
                Beheer categorieën, test-suites en scripts.
            </p>
        </div>

        @if (Model.SelectedWorkspaceId.HasValue)
        {
            <a asp-controller="TestStructure"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Andere workspace kiezen
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.SelectedWorkspaceId.HasValue)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Kies een workspace</h5>
                <p class="text-muted">
                    Selecteer de workspace waarvan je de teststructuur wilt beheren.
                </p>

                @if (!Model.Workspaces.Any())
                {
                    <div class="alert alert-warning mb-0">
                        Er zijn geen workspaces beschikbaar.
                        Een administrator moet eerst een workspace aanmaken.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Workspace</th>
                                    <th>Actie</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var workspace in Model.Workspaces)
                                {
                                    <tr>
                                        <td class="fw-semibold">@workspace.Text</td>
                                        <td>
                                            <a asp-controller="TestStructure"
                                               asp-action="Index"
                                               asp-route-workspaceId="@workspace.Value"
                                               class="btn btn-sm btn-outline-primary">
                                                Teststructuur openen
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">Nieuwe categorie</h5>

                <form asp-action="CreateCategory"
                      method="post"
                      class="row g-3 align-items-end">
                    @Html.AntiForgeryToken()

                    <input asp-for="SelectedWorkspaceId" type="hidden" />
                    <input asp-for="CategoryWorkspaceId" type="hidden" />

                    <div class="col-md-9">
                        <label class="form-label">Categorienaam</label>
                        <input asp-for="NewCategoryName"
                               class="form-control"
                               placeholder="Bijv. Website" />
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            Categorie toevoegen
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (!Model.Categories.Any())
        {
            <div class="alert alert-info">
                Deze workspace bevat nog geen categorieën.
            </div>
        }
        else
        {
            @foreach (var category in Model.Categories)
            {
                var categorySuites = Model.TestSuites
                    .Where(ts => ts.CategoryId == category.Id)
                    .OrderBy(ts => ts.Name)
                    .ToList();

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0">@category.Name</h5>
                            <small class="text-muted">@Model.SelectedWorkspaceName</small>
                        </div>

                        <form asp-action="DeleteCategory" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@category.Id" />
                            <input type="hidden" name="workspaceId"
                                   value="@Model.SelectedWorkspaceId" />

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Weet je zeker dat je deze categorie wilt verwijderen?');">
                                Verwijderen
                            </button>
                        </form>
                    </div>

                    <div class="card-body">
                        <form asp-action="CreateTestSuite"
                              method="post"
                              class="row g-3 align-items-end mb-4">
                            @Html.AntiForgeryToken()

                            <input asp-for="SelectedWorkspaceId" type="hidden" />
                            <input type="hidden"
                                   name="TestSuiteCategoryId"
                                   value="@category.Id" />

                            <div class="col-md-9">
                                <label class="form-label">
                                    Nieuwe test-suite binnen @category.Name
                                </label>
                                <input name="NewTestSuiteName"
                                       class="form-control"
                                       placeholder="Bijv. MyKreuze" />
                            </div>

                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary w-100">
                                    Test-suite toevoegen
                                </button>
                            </div>
                        </form>

                        @if (!categorySuites.Any())
                        {
                            <div class="alert alert-info mb-0">
                                Deze categorie bevat nog geen test-suites.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Test-suite</th>
                                            <th>Acties</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var testSuite in categorySuites)
                                        {
                                            <tr>
                                                <td class="fw-semibold">@testSuite.Name</td>
                                                <td>
                                                    <a asp-controller="ScriptsForm"
                                                       asp-action="Index"
                                                       asp-route-testSuiteId="@testSuite.Id"
                                                       class="btn btn-sm btn-outline-primary">
                                                        Scripts openen
                                                    </a>

                                                    <form asp-action="DeleteTestSuite"
                                                          method="post"
                                                          class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden"
                                                               name="id"
                                                               value="@testSuite.Id" />
                                                        <input type="hidden"
                                                               name="workspaceId"
                                                               value="@Model.SelectedWorkspaceId" />

                                                        <button type="submit"
                                                                class="btn btn-sm btn-outline-danger"
                                                                onclick="return confirm('Weet je zeker dat je deze test-suite wilt verwijderen?');">
                                                            Verwijderen
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        }

        var unlinkedSuites = Model.TestSuites
            .Where(ts => !ts.CategoryId.HasValue)
            .ToList();

        @if (unlinkedSuites.Any())
        {
            <div class="alert alert-warning">
                Er zijn @unlinkedSuites.Count oude test-suite(s)
                die nog niet aan een categorie zijn gekoppeld.
            </div>
        }
    }
</div>