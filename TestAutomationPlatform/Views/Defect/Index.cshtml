@model List<TestAutomationPlatform.Models.Defect>

@{
    ViewData["Title"] = "Defectenoverzicht";
}

<div class="container mt-4">
    <h2>Defectenoverzicht</h2>
    <p class="text-muted">Overzicht van aangemaakte defecten vanuit gefaalde testresultaten.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Er zijn nog geen defecten aangemaakt.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Titel</th>
                    <th>Status</th>
                    <th>Prioriteit</th>
                    <th>Testresultaat ID</th>
                    <th>Aangemaakt op</th>
                    <th>Actie</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var defect in Model)
                {
                    <tr>
                        <td>@defect.Title</td>
                        <td>
                            <span class="badge bg-secondary">@defect.Status</span>
                        </td>
                        <td>@defect.Priority</td>
                        <td>@defect.RunResultId</td>
                        <td>@defect.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td>
                        <td>
                            <a asp-controller="Defect"
                                   asp-action="Details"
                                   asp-route-id="@defect.Id"
                                   class="btn btn-primary btn-sm">
                                Bekijken
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">
        Terug naar dashboard
    </a>
</div>